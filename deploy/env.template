# FindClient .env — новая версия (origin/main)
# Обязательно: BOT_TOKEN. Очень рекомендуется: OWNER_IDS.
# Всё остальное — по желанию. TWOGIS_API_KEY больше НЕ нужен: ключ 2GIS
# берётся со страницы 2gis.ru в рантайме.

# --- обязательно ---------------------------------------------------------
# Токен от @BotFather. Тот же, что у старой версии, — подойдёт.
BOT_TOKEN=

# --- очень рекомендуется ------------------------------------------------
# Ваш Telegram user ID (не username). Бот сам скажет его, если вы не в списке.
# Несколько ID — через запятую. Пусто = бот открыт любому, кто его найдёт.
OWNER_IDS=

# --- источники ----------------------------------------------------------
# Официальный ключ Яндекса «API Поиска по организациям».
# Без него работает веб-режим без ключа (первая страница + пагинация через curl_cffi).
YANDEX_API_KEY=

# Прокси ТОЛЬКО для запросов к Яндексу, если он начнёт показывать капчу.
# Формат: http://user:pass@host:port
HTTP_PROXY=

# --- аккаунт Telegram (Telethon) для чтения групп ------------------------
# Получить на https://my.telegram.org -> API development tools.
# Затем на сервере:  .venv/bin/python scripts/tg_login.py
# Скрипт напечатает строку TG_SESSION — вставьте её сюда.
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# --- прочее --------------------------------------------------------------
# Период опроса бирж заказов, секунды. Минимум 60.
ORDERS_POLL_INTERVAL=300
# Пауза между запросами к картам, секунды.
REQUEST_DELAY=0.3
# Файл SQLite. Относительный путь — от WorkingDirectory сервиса (/opt/findclient).
DB_PATH=scraper.db
