[Unit]
Description=FindClient CRM — воркер отправки
Documentation=file:/opt/2gi_scraper/crm/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Не root: выделенный пользователь (deploy/ensure_user.sh)
User=findclient
Group=findclient
WorkingDirectory=/opt/2gi_scraper
EnvironmentFile=/opt/2gi_scraper/crm.env
ExecStart=/opt/2gi_scraper/venv/bin/python -m crm.sender
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

# Отправку можно и нужно останавливать одной командой, не трогая панель:
#   systemctl stop findclient-sender
#
# Файл Telethon-сессии лежит в /opt/2gi_scraper/.sessions (ensure_user.sh
# переносит его из /root) - запись туда разрешена ReadWritePaths.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/2gi_scraper
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
