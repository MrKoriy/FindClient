[Unit]
Description=FindClient Telegram bot (map + Telegram lead sourcing)
Documentation=https://github.com/MrKoriy/FindClient
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=findclient
Group=findclient
WorkingDirectory=/opt/findclient

# .env lives next to the code and is the single source of configuration.
EnvironmentFile=/opt/findclient/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/opt/findclient/.venv/bin/python /opt/findclient/bot.py

# The bot polls Telegram with getUpdates: exactly ONE instance may run,
# otherwise Telegram answers 409 Conflict and both copies thrash.
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

# Modest hardening; the bot only needs to write its SQLite DB in WorkingDirectory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/findclient

StandardOutput=journal
StandardError=journal
SyslogIdentifier=findclient

[Install]
WantedBy=multi-user.target
