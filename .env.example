# Required
BOT_TOKEN=your_telegram_bot_token_here
# REQUIRED: your Telegram user ID(s), comma-separated. Empty = the bot refuses everyone
# (it still replies with the sender's ID so you can copy it here).
OWNER_IDS=

# --- CRM panel login from the bot (/crm) ---
# Public HTTPS address of the CRM panel, e.g. https://crm.example.com:9444
CRM_URL=
# Secret for signing one-time /crm links, >= 32 chars, the SAME value as in crm.env.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CRM_SECRET_KEY=

# Optional: official Yandex "API Поиска по организациям" key (keyless web mode is used otherwise)
YANDEX_API_KEY=
# Optional: proxy for Yandex requests, e.g. http://user:pass@host:port (helps against captcha)
HTTP_PROXY=

# Optional: Telegram user account for reading builder/realtor groups (python scripts/tg_login.py)
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# Freelance orders polling interval, seconds (min 60)
ORDERS_POLL_INTERVAL=300
REQUEST_DELAY=0.3
DB_PATH=scraper.db

# --- Outreach ---
# Second (third...) Telegram account for sending; generate each with scripts/tg_login.py
TG_SESSION_2=
# DeepSeek via B.AI (offers, personalisation, reply drafts, demo-site copy)
BAI_API_KEY=
BAI_MODEL=DeepSeek-V4.1-Flash
# Optional: TypeSafe Jev for fast reply classification (falls back to DeepSeek, then rules)
TYPESAFE_API_KEY=
# Public address of this server for demo sites, e.g. https://demo.example.com
DEMO_BASE_URL=
WEB_PORT=8080
# Max new dialogs per account per day after warm-up (starts at 5, +3 per active day)
OUTREACH_DAILY_MAX=20
OUTREACH_WORK_HOURS=10-19
