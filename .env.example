# Required
BOT_TOKEN=your_telegram_bot_token_here
# Your Telegram user ID(s), comma-separated (the bot tells you the ID if you are not allowed)
OWNER_IDS=

# Optional: official Yandex "API Поиска по организациям" key (keyless web mode is used otherwise)
YANDEX_API_KEY=
# Optional: proxy for Yandex requests, e.g. http://user:pass@host:port (helps against captcha)
HTTP_PROXY=

# Optional: Telegram user account for reading builder/realtor groups (python scripts/tg_login.py)
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# Freelance orders polling interval, seconds (min 60)
ORDERS_POLL_INTERVAL=300
REQUEST_DELAY=0.3
DB_PATH=scraper.db
